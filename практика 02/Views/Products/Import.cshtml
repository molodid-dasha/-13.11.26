@model ImportViewModel
@{
    ViewData["Title"] = "Импорт товара";
    Layout = "_Layout";
}

<div style="display: flex; flex-direction: column; align-items: center; margin-top: 40px;">

    <h1 style="color: #2e7d32; font-size: 36px; margin-bottom: 30px;">Импорт товара</h1>

    <!-- Карточка с формой по центру -->
    <form method="post" asp-action="Import" style="background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 8px 30px rgba(46, 125, 50, 0.08); border: 1px solid #e0f2e0; width: 100%; max-width: 500px; text-align: center;">
        @Html.AntiForgeryToken()

        <div style="margin-bottom: 25px; display: flex; flex-direction: column; align-items: flex-start;">
            <label for="filePath" style="font-size: 14px; color: #555; margin-bottom: 8px; font-weight: 600;">Путь к CSV-файлу:</label>
            <input type="text" id="filePath" name="filePath"
                   value="@Model.FilePath"
                   placeholder="/csv/sample_products.csv"
                   style="width: 100%; padding: 14px; border: 1px solid #c8e6c9; border-radius: 8px; font-size: 15px; outline: none; transition: 0.3s;"
                   onfocus="this.style.borderColor='#4caf50'; this.style.boxShadow='0 0 0 3px rgba(76, 175, 80, 0.1)';"
                   onblur="this.style.borderColor='#c8e6c9'; this.style.boxShadow='none';" />
        </div>

        <button type="submit" class="btn" style="width: 100%; padding: 14px; font-size: 16px; font-weight: 600;">
            Импортировать товары
        </button>
    </form>

    <!-- Блок результатов импорта -->
    @if (Model.Result != null)
    {
        <div style="margin-top: 40px; background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 8px 30px rgba(46, 125, 50, 0.08); border: 1px solid #e0f2e0; width: 100%; max-width: 800px; animation: fadeIn 0.5s ease-in-out;">
            <h2 style="color: #2e7d32; text-align: center; margin-top: 0;">Результат импорта</h2>

            @if (Model.Result.ErrorCount == 0 && Model.Result.ImportedCount > 0)
            {
                <div class="alert success" style="text-align: center;">Импорт выполнен успешно.</div>
            }

            <table>
                <tr><th>Показатель</th><th>Значение</th></tr>
                <tr><td>Всего строк</td><td>@Model.Result.TotalRows</td></tr>
                <tr><td>Успешно импортировано</td><td>@Model.Result.ImportedCount</td></tr>
                <tr><td>Ошибки</td><td>@Model.Result.ErrorCount</td></tr>
            </table>

            @if (Model.Result.Errors.Count > 0)
            {
                <h3 style="color: #c62828; margin-top: 30px;">Список ошибок</h3>
                <table>
                    <tr><th>Строка</th><th>Описание ошибки</th></tr>
                    @foreach (var e in Model.Result.Errors)
                    {
                        <tr><td>@e.RowNumber</td><td>@e.Message</td></tr>
                    }
                </table>
            }

            <div style="text-align: center; margin-top: 30px;">
                <a asp-action="Index" class="btn">Перейти к списку товаров</a>
            </div>
        </div>
    }
</div>